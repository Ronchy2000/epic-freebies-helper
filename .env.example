# Epic account
# Required.
# Wrap the password in quotes if it contains spaces, #, =, or other shell-sensitive characters.
EPIC_EMAIL=
EPIC_PASSWORD=

# Multi-account support (optional, overrides EPIC_EMAIL/EPIC_PASSWORD)
# For GitHub Actions Secrets, create EPIC_ACCOUNTS as a multiline secret:
# user1@example.com:password1
# user2@example.com:password2
#
# For local .env files, keep using EPIC_EMAIL/EPIC_PASSWORD unless your
# dotenv parser supports multiline values.

# LLM provider
# Supported values: gemini, glm, deepseek
# Keep this in sync with the key you actually fill below:
# - LLM_PROVIDER=glm      -> create and fill GLM_API_KEY only
# - LLM_PROVIDER=gemini   -> create and fill GEMINI_API_KEY only
# - LLM_PROVIDER=deepseek -> create and fill DEEPSEEK_API_KEY only
LLM_PROVIDER=glm

# GLM
# Required when LLM_PROVIDER=glm.
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.6v

# DeepSeek V4
# Reserved placeholder only. Do not enable yet for the current captcha flow.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING_ENABLED=false
DEEPSEEK_REASONING_EFFORT=high

# Gemini / AiHubMix
# Required when LLM_PROVIDER=gemini.
GEMINI_API_KEY=
# Optional. Leave empty to use the official Gemini endpoint directly.
GEMINI_BASE_URL=https://aihubmix.com
GEMINI_MODEL=gemini-2.5-pro

# OpenAI / GPT
# Only use this section with a code version that includes the OpenAI provider.
# OPENAI_MODEL must support image input.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini

# Advanced model overrides
# Optional. Leave empty unless different models are required for different captcha tasks.
CHALLENGE_CLASSIFIER_MODEL=
IMAGE_CLASSIFIER_MODEL=
SPATIAL_POINT_REASONER_MODEL=
SPATIAL_PATH_REASONER_MODEL=

# Browser runtime
# Supported values: auto, camoufox, playwright
BROWSER_BACKEND=auto
# Supported values: true, false, virtual. Defaults to virtual on Linux and false elsewhere.
HEADLESS=
# Optional. Example: http://username:password@host:port or socks5://host:port
BROWSER_PROXY=

# hCaptcha runtime limits
# Keep recursive upstream retries disabled; application flows already use bounded retries.
RETRY_ON_FAILURE=false
EXECUTION_TIMEOUT=120
RESPONSE_TIMEOUT=30

# Runtime
ENABLE_APSCHEDULER=false
