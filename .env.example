# Epic account
# If a value contains $, \, #, or ` (e.g. some passwords), wrap it in single
# quotes so python-dotenv keeps it as a literal: EPIC_PASSWORD='abc$def'.
# This only affects local .env files; GitHub Actions Secrets are unaffected.
EPIC_EMAIL=xxxx@qq.com
EPIC_PASSWORD=mypassword

# Multi-account support (optional, overrides EPIC_EMAIL/EPIC_PASSWORD)
# For GitHub Actions Secrets, create EPIC_ACCOUNTS as a multiline secret:
# user1@example.com:password1
# user2@example.com:password2
#
# For local .env files, keep using EPIC_EMAIL/EPIC_PASSWORD unless your
# dotenv parser supports multiline values.

# LLM provider
# Supported values: gemini, glm
# Keep this in sync with the key you actually fill below:
# - LLM_PROVIDER=glm    -> create and fill GLM_API_KEY only
# - LLM_PROVIDER=gemini -> create and fill GEMINI_API_KEY only
LLM_PROVIDER=glm

# GLM (recommended)
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.6v

# Official Gemini API (optional)
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=gemini-2.5-pro

# For AiHubMix or another Gemini-compatible relay, set GEMINI_BASE_URL explicitly.
# Example: https://aihubmix.com

# Optional model overrides
# Leave these empty to follow GLM_MODEL or GEMINI_MODEL automatically.
# Example for GLM: glm-4.6v
# Example for Gemini / AiHubMix: gemini-2.5-pro
CHALLENGE_CLASSIFIER_MODEL=
IMAGE_CLASSIFIER_MODEL=
SPATIAL_POINT_REASONER_MODEL=
SPATIAL_PATH_REASONER_MODEL=

# Browser runtime
# Supported values: auto, camoufox, playwright
BROWSER_BACKEND=auto
# Supported values: true, false, virtual. Defaults to virtual on Linux and false elsewhere.
HEADLESS=
# Optional. Example: http://username:password@host:port or socks5://host:port
BROWSER_PROXY=

# hCaptcha runtime limits
# Keep recursive upstream retries disabled; application flows already use bounded retries.
RETRY_ON_FAILURE=false
EXECUTION_TIMEOUT=120
RESPONSE_TIMEOUT=30
# Allow a bounded login attempt to finish more than one difficult hCaptcha round.
AUTH_TIMEOUT_SECONDS=420
# Keep authentication retries bounded; repeated Epic logins can increase risk checks.
AUTH_MAX_ATTEMPTS=2

# Local one-shot debugging
ENABLE_APSCHEDULER=false
